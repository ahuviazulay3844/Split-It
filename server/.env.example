# Free tier: ~20 requests/day per model (resets midnight Pacific). One chat message = 1 request.
# GEMINI_TIMEOUT_MS=20000
# GEMINI_TLS_INSECURE=true
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- AI assistant (autonomy / conversation) ---
# How many prior turns to feed the model as context. 0 = keep ALL turns (fully
# unlimited). The conversation length itself is never capped by this.
# ASSISTANT_HISTORY_TURNS=50
# Max history turns accepted in one request payload (guards payload size only).
# ASSISTANT_MAX_HISTORY_TURNS=200
# Smart retry on transient "busy"/"rate" Gemini responses (never on daily quota).
# ASSISTANT_MAX_RETRIES=2
# ASSISTANT_MAX_RETRY_WAIT_MS=4000
